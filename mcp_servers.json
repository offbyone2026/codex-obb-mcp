{
  "servers": {
    "godot": {
      "name": "Godot MCP",
      "engine": "Godot 4.x",
      "install": "npm/npx",
      "command": "npx",
      "args": ["-y", "godot-mcp-server"],
      "env": { "GODOT_PORT": "9080" },
      "plugin": "MCP Bridge（AssetLib 安装，项目内 addons/mcp_bridge）",
      "tools": 42,
      "category": "scene|script|project|asset|visualization"
    },
    "unity": {
      "name": "Unity MCP",
      "engine": "Unity Editor",
      "install": "UPM/仓库复制",
      "repo": "CoplayDev/unity-mcp",
      "tools": 40,
      "category": "scene|asset|script|automation",
      "note": "备选 AnkleBreaker-Studio/unity-mcp-server 268 tools"
    },
    "unreal": {
      "name": "Unreal MCP",
      "engine": "Unreal Engine 5",
      "install": "pip install unrealmcp",
      "command": "unrealmcp",
      "args": [],
      "env": {},
      "plugin": "C++ 插件 TCP server localhost:55557（自动发现编辑器）",
      "tools": 280,
      "category": "asset|blueprint|material|datatable|actor|niagara|statetree|input|umg|profiling"
    },
    "steam": {
      "name": "Steam MCP",
      "install": "uvx steam-mcp",
      "command": "uvx",
      "args": ["steam-mcp"],
      "env": {},
      "port": 11020,
      "tools": 14,
      "category": "profile|library|stats|store|workshop",
      "note": "发行商侧备选 TMHSDigital/Steam-MCP 26 tools（含 Publisher 操作）"
    },
    "blender": {
      "name": "Blender MCP",
      "engine": "Blender 4.x",
      "install": "uv tool run mcp-for-blender install-addon + GUI 启动 socket",
      "command": "uvx",
      "args": ["mcp-for-blender"],
      "env": {},
      "port": 9876,
      "tools": 157,
      "category": "mesh|material|texture|scene|render",
      "note": "本机已部署验证（Blender 4.5.14 LTS）",
      "finer_grained": "见 finer-grained.md 第一节"
    },
    "sora": {
      "name": "Sora MCP（视频生成）",
      "engine": "OpenAI Sora 2 API",
      "install": "git clone Porkbutts/sora-mcp-server + npm install/build",
      "command": "node",
      "args": ["D:/work/mcp-servers/sora-mcp-server/dist/index.js"],
      "env": { "OPENAI_API_KEY": "sk-...（需开通 Sora 权限）", "DOWNLOAD_DIR": "D:/work/Assets/videos" },
      "tools": 8,
      "category": "video|text-to-video|image-to-video|remix|job",
      "note": "备选 Doriandarko/sora-mcp（stdio+HTTP 双模式）；托管备选 AceDataCloud/SoraMCP",
      "doc": "sora-mcp.md"
    },
    "ludo": {
      "name": "Ludo MCP（AI 素材全栈）",
      "engine": "Ludo AI 平台",
      "install": "npx @ludo-ai/mcp（以仓库 README 为准）",
      "command": "npx",
      "args": ["-y", "@ludo-ai/mcp"],
      "env": { "LUDO_API_KEY": "ludo_..." },
      "tools": 30,
      "category": "sprite|3d-model|animation|video|audio|tts|job",
      "note": "GitHub: ludo-ai/ludo-mcp；异步任务队列；生成前先查余额",
      "doc": "ludo-mcp.md"
    },
    "cocos": {
      "name": "Cocos Creator MCP",
      "engine": "Cocos Creator 3.x",
      "install": "npm 启动 MCP server + 编辑器扩展（搜 Cocos MCP 或手动导入）",
      "command": "npx",
      "args": [],
      "env": {},
      "tools": 30,
      "category": "scene|node|component|asset|code",
      "note": "GitHub: DaxianLee/cocos-mcp-server（1300+ 星）；备选 RomaRogov/cocos-mcp（HTTP）",
      "doc": "cocos-mcp.md"
    },
    "3dgen": {
      "name": "AI 3D 生成 MCP（文生3D/图生3D）",
      "engine": "Tripo3D / Hyper3D Rodin / Meshy",
      "install": "npm 安装 mcp-3d-gen + 任一供应商 API key",
      "command": "npx",
      "args": [],
      "env": { "TRIPO_API_KEY": "t-...", "MESHY_API_KEY": "..." },
      "tools": 10,
      "category": "text-to-3d|image-to-3d|glb|fbx|obj|bake",
      "note": "GitHub: kevinten-ai/mcp-3d-gen；备选 MubarakHAlketbi/game-asset-mcp(HF)、HurtzDonutStudios/ai-forge-mcp(AAA 565 tools)",
      "doc": "3d-asset-gen-mcp.md"
    },
    "elevenlabs": {
      "name": "ElevenLabs MCP（TTS/配音）",
      "engine": "ElevenLabs API",
      "install": "npm @elevenlabs/elevenlabs-mcp（托管）或本地部署",
      "command": "npx",
      "args": [],
      "env": { "ELEVENLABS_API_KEY": "sk_..." },
      "tools": 15,
      "category": "tts|voice|audio|multi-language|clone",
      "note": "官方实现 elevenlabs/elevenlabs-mcp；音乐备选 unforced/suno-mcp、zaptrem/music-mcp",
      "doc": "audio-music-mcp.md"
    },
    "playwright": {
      "name": "Playwright MCP（Web 自动化测试）",
      "engine": "浏览器（Chromium/Firefox/WebKit）",
      "install": "npx @playwright/mcp 或客户端内置",
      "command": "npx",
      "args": ["-y", "@playwright/mcp"],
      "env": {},
      "tools": 30,
      "category": "browser|ui-test|click|form|screenshot|spa",
      "note": "微软官方 microsoft/playwright-mcp；Web 游戏端到端测试",
      "doc": "game-testing-mcp.md"
    }
  }
}
